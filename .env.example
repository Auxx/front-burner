FRONT_BURNER_PORT=8080
FRONT_BURNER_DATA_DIR=tmp/data
FRONT_BURNER_LOG_FORMAT=pretty
FRONT_BURNER_LOG_LEVEL=debug
# The secret that administrator onboarding asks for, so that only the operator can create the first administrator.
# FRONT_BURNER_SETUP_TOKEN=
# Signs the auth tokens; at least 32 characters. For development only: generate your own for a real instance.
FRONT_BURNER_JWT_SECRET=development-only-jwt-secret-change-me-0123456789
# Encrypts the stored secrets; at least 32 characters and different from the JWT secret. Back it up apart from the data.
FRONT_BURNER_ENCRYPTION_KEY=development-only-encryption-key-change-me-012345
