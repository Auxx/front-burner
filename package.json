  "scripts": {
    "format": "dprint fmt",
    "format:check": "dprint check",
    "prepare": "husky || true",
    "lint": "nx run-many --all --target=lint",
    "lint:ci": "nx affected -t lint --base=origin/master --head=HEAD",
