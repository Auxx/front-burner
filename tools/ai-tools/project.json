{
  "name": "ai-tools",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/ai-tools/src",
  "projectType": "library",
  "tags": [
    "scope:tools",
    "type:util"
  ],
  "implicitDependencies": [
    "ui"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "externalDependencies": [
            "@vscode/codicons"
          ]
        }
      ],
      "options": {
        "command": "vitest run",
        "cwd": "tools/ai-tools"
      }
    }
  }
}
