{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@front-burner/ui": [
        "./libs/ui/src/index.ts"
      ],
      "@front-burner/shared-contracts": [
        "./libs/shared/contracts/src/index.ts"
      ],
      "@front-burner/server-core-config": [
        "./libs/server/core/config/src/index.ts"
      ],
      "@front-burner/server-core-database": [
        "./libs/server/core/database/src/index.ts"
      ],
      "@front-burner/server-core-observability": [
        "./libs/server/core/observability/src/index.ts"
      ],
      "@front-burner/server-feature-auth/testing": [
        "./libs/server/feature/auth/src/testing/index.ts"
      ],
      "@front-burner/server-core-security/testing": [
        "./libs/server/core/security/src/testing/index.ts"
      ],
      "@front-burner/server-core-security": [
        "./libs/server/core/security/src/index.ts"
      ],
      "@front-burner/web-api-client": [
        "./libs/web/api-client/src/index.ts"
      ],
      "@front-burner/web-core/app": [
        "./libs/web/core/src/app.ts"
      ],
      "@front-burner/web-core": [
        "./libs/web/core/src/index.ts"
      ],
      "@front-burner/web-feature-auth": [
        "./libs/web/feature-auth/src/index.ts"
      ],
      "@front-burner/server-feature-auth": [
        "./libs/server/feature/auth/src/index.ts"
      ],
      "@front-burner/shared-util": [
        "./libs/shared/util/src/index.ts"
      ],
      "@front-burner/web-shell": [
        "./libs/web/shell/src/index.ts"
      ],
      "@front-burner/web-feature-dashboard": [
        "./libs/web/feature-dashboard/src/index.ts"
      ],
      "@front-burner/server-core-crypto": [
        "./libs/server/core/crypto/src/index.ts"
      ],
      "@front-burner/server-feature-repositories": [
        "./libs/server/feature/repositories/src/index.ts"
      ],
      "@front-burner/server-core-git/testing": [
        "./libs/server/core/git/src/testing/index.ts"
      ],
      "@front-burner/server-core-git": [
        "./libs/server/core/git/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
