{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@front-burner/ui": [
        "./libs/ui/src/index.ts"
      ],
      "@front-burner/shared-contracts": [
        "./libs/shared/contracts/src/index.ts"
      ],
      "@front-burner/server-core-config": [
        "./libs/server/core/config/src/index.ts"
      ],
      "@front-burner/server-core-database": [
        "./libs/server/core/database/src/index.ts"
      ],
      "@front-burner/server-core-observability": [
        "./libs/server/core/observability/src/index.ts"
      ],
      "@front-burner/server-core-security": [
        "./libs/server/core/security/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
