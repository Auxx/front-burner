{
  "name": "web-core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/core/src",
  "prefix": "core",
  "projectType": "library",
  "tags": [
    "scope:web",
    "type:data-access"
  ],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production"
      ],
      "options": {
        "command": "vitest run",
        "cwd": "libs/web/core"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "options": {
        "commands": [
          "tsc --noEmit -p libs/web/core/tsconfig.lib.json",
          "tsc --noEmit -p libs/web/core/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
