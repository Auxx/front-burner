{
  "name": "server-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/server-e2e/src",
  "projectType": "application",
  "tags": [
    "scope:server",
    "type:app"
  ],
  "implicitDependencies": [
    "server"
  ],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": true
        },
        {
          "runtime": "node --version"
        }
      ],
      "dependsOn": [
        "server:build"
      ],
      "options": {
        "command": "vitest run --exclude 'src/container*.e2e.spec.ts'",
        "cwd": "apps/server-e2e"
      }
    },
    "e2e-container": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --no-file-parallelism src/container.e2e.spec.ts src/container-resilience.e2e.spec.ts",
        "cwd": "apps/server-e2e"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "options": {
        "commands": [
          "tsc --noEmit -p apps/server-e2e/tsconfig.spec.json"
        ]
      }
    }
  }
}
