{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-e2e/src",
  "implicitDependencies": [
    "web",
    "server"
  ],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "dependentTasksOutputFiles": "**/*",
          "transitive": true
        },
        {
          "runtime": "node --version"
        },
        {
          "env": "E2E_BROWSERS"
        }
      ],
      "dependsOn": [
        "web:build",
        "server:build"
      ],
      "options": {
        "command": "playwright test",
        "cwd": "apps/web-e2e"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "options": {
        "commands": [
          "tsc --noEmit -p apps/web-e2e/tsconfig.json"
        ]
      }
    }
  },
  "tags": [
    "scope:web",
    "type:app"
  ]
}
