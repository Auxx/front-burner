  "info": {
    "title": "Front Burner API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "fail"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "LoginMethods": {
        "type": "object",
        "properties": {
          "oidc": {
            "type": "string",
            "enum": [
              "not-configured",
              "available",
              "unavailable"
            ]
          },
          "passwordReset": {
            "type": "boolean"
          }
        },
        "required": [
          "oidc",
          "passwordReset"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "refreshTokenDelivery": {
            "default": "cookie",
            "type": "string",
            "enum": [
              "cookie",
              "body"
            ]
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SessionTokens": {
        "type": "object",
        "properties": {
          "authToken": {
            "type": "string"
          },
          "authTokenExpiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "authToken",
          "authTokenExpiresAt",
          "refreshTokenExpiresAt"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "OidcExchangeRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "refreshTokenDelivery": {
            "default": "cookie",
            "type": "string",
            "enum": [
              "cookie",
              "body"
            ]
          }
        },
        "required": [
          "code"
        ]
      },
      "CurrentUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "administrator",
              "user"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "role"
        ]
      },
      "OnboardingStatus": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "required",
              "oidc-pending",
              "completed"
            ]
          },
          "oidcFromEnvironment": {
            "type": "boolean"
          },
          "setupTokenConfigured": {
            "type": "boolean"
          }
        },
        "required": [
          "state",
          "oidcFromEnvironment",
          "setupTokenConfigured"
        ]
      },
      "SetupTokenRequest": {
        "type": "object",
        "properties": {
          "setupToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "setupToken"
        ]
      },
      "PasswordSetupRequest": {
        "type": "object",
        "properties": {
          "setupToken": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "setupToken",
          "email",
          "displayName",
          "password"
        ]
      },
      "OidcSetupRequest": {
        "type": "object",
        "properties": {
          "setupToken": {
            "type": "string",
            "minLength": 1
          },
          "issuer": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "clientId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "clientSecret": {
            "type": "string",
            "maxLength": 1024
          },
          "scopes": {
            "default": "openid email profile",
            "type": "string",
            "maxLength": 512
          },
          "requireVerifiedEmail": {
            "default": true,
            "type": "boolean"
          },
          "adminEmail": {
            "type": "string"
          }
        },
        "required": [
          "setupToken",
          "issuer",
          "clientId",
          "adminEmail"
        ]
      },
      "OidcSetupView": {
        "type": "object",
        "properties": {
          "issuer": {
            "type": "string"
          },
          "clientId": {
            "type": "string"
          },
          "scopes": {
            "type": "string"
          },
          "requireVerifiedEmail": {
            "type": "boolean"
          },
          "adminEmail": {
            "type": "string"
          },
          "hasClientSecret": {
            "type": "boolean"
          }
        },
        "required": [
          "issuer",
          "clientId",
          "scopes",
          "requireVerifiedEmail",
          "adminEmail",
          "hasClientSecret"
        ]
      }
    }
  }
}
