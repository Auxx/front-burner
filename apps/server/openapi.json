  "info": {
    "title": "Front Burner API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "fail"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "LoginMethods": {
        "type": "object",
        "properties": {
          "oidc": {
            "type": "string",
            "enum": [
              "not-configured",
              "available",
              "unavailable"
            ]
          },
          "passwordReset": {
            "type": "boolean"
          }
        },
        "required": [
          "oidc",
          "passwordReset"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "refreshTokenDelivery": {
            "default": "cookie",
            "type": "string",
            "enum": [
              "cookie",
              "body"
            ]
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SessionTokens": {
        "type": "object",
        "properties": {
          "authToken": {
            "type": "string"
          },
          "authTokenExpiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "authToken",
          "authTokenExpiresAt",
          "refreshTokenExpiresAt"
        ]
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "OidcExchangeRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "refreshTokenDelivery": {
            "default": "cookie",
            "type": "string",
            "enum": [
              "cookie",
              "body"
            ]
          }
        },
        "required": [
          "code"
        ]
      },
      "CurrentUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "administrator",
              "user"
            ]
          },
          "allowedGitLevels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "simple",
                "guided",
                "advanced"
              ]
            }
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "allowedGitLevels"
        ]
      },
      "SavedHttpsCredentials": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "missing": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "username",
          "missing"
        ]
      },
      "SavedSshKey": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string"
          },
          "keyType": {
            "type": "string",
            "enum": [
              "ed25519",
              "ecdsa",
              "rsa"
            ]
          },
          "fingerprint": {
            "type": "string"
          },
          "passphraseProtected": {
            "type": "boolean"
          },
          "unlocked": {
            "type": "boolean"
          },
          "generated": {
            "type": "boolean"
          },
          "missing": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "keyType",
          "fingerprint",
          "passphraseProtected",
          "unlocked",
          "generated",
          "missing"
        ]
      },
      "SavedCredentials": {
        "type": "object",
        "properties": {
          "https": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SavedHttpsCredentials"
            }
          },
          "sshKeys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SavedSshKey"
            }
          }
        },
        "required": [
          "https",
          "sshKeys"
        ]
      },
      "GenerateSshKeyRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "name"
        ]
      },
      "GeneratedSshKey": {
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/components/schemas/SavedSshKey"
          },
          "publicKey": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "publicKey"
        ]
      },
      "UnlockSshKeyRequest": {
        "type": "object",
        "properties": {
          "passphrase": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "passphrase"
        ]
      },
      "TrustHostRequest": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^(?:[A-Za-z0-9.-]+|[0-9A-Fa-f.]*:[0-9A-Fa-f:.]*)$"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "type": {
            "type": "string",
            "enum": [
              "ssh-ed25519",
              "ecdsa-sha2-nistp256",
              "ecdsa-sha2-nistp384",
              "ecdsa-sha2-nistp521",
              "ssh-rsa"
            ]
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[A-Za-z0-9+/]+={0,2}$"
          }
        },
        "required": [
          "host",
          "port",
          "type",
          "key"
        ]
      },
      "RepositorySummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string"
          },
          "remote": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "needs-confirmation",
              "cloning",
              "ready",
              "error"
            ]
          },
          "error": {
            "type": "string",
            "enum": [
              "clone-failed",
              "clone-timed-out",
              "working-copy-missing",
              null
            ],
            "nullable": true
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "credentials-refused",
                "cannot-push",
                "host-key-changed",
                "key-locked"
              ]
            }
          },
          "lastAccessedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "name",
          "remote",
          "status",
          "error",
          "warnings",
          "lastAccessedAt"
        ]
      },
      "RecentRepositories": {
        "type": "object",
        "properties": {
          "repositories": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RepositorySummary"
            }
          }
        },
        "required": [
          "repositories"
        ]
      },
      "RepositoryIndex": {
        "type": "object",
        "properties": {
          "repositories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "remoteKey": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "remoteKey"
              ]
            }
          }
        },
        "required": [
          "repositories"
        ]
      },
      "RepositoryCredentials": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "none"
                ]
              }
            },
            "required": [
              "mode"
            ]
          },
          {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "saved"
                ]
              },
              "credentialId": {
                "type": "integer",
                "exclusiveMinimum": true,
                "maximum": 9007199254740991,
                "minimum": 0
              },
              "passphrase": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            },
            "required": [
              "mode",
              "credentialId"
            ]
          },
          {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "new-https"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "username": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "password": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "mode",
              "name",
              "username",
              "password"
            ]
          },
          {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "new-ssh-key"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "privateKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "passphrase": {
                "type": "string",
                "maxLength": 1024
              }
            },
            "required": [
              "mode",
              "name",
              "privateKey"
            ]
          }
        ]
      },
      "AccessCheckRequest": {
        "type": "object",
        "properties": {
          "remoteUrl": {
            "type": "string"
          },
          "credentials": {
            "$ref": "#/components/schemas/RepositoryCredentials"
          }
        },
        "required": [
          "remoteUrl",
          "credentials"
        ]
      },
      "AccessCheckResult": {
        "type": "object",
        "properties": {
          "branches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "defaultBranch": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "branches",
          "defaultBranch"
        ]
      },
      "AddRepositoryRequest": {
        "type": "object",
        "properties": {
          "remoteUrl": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "credentials": {
            "$ref": "#/components/schemas/RepositoryCredentials"
          },
          "cloneMode": {
            "type": "string",
            "enum": [
              "full",
              "single-branch"
            ]
          },
          "branch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "gitLevel": {
            "type": "string",
            "enum": [
              "simple",
              "guided",
              "advanced"
            ]
          }
        },
        "required": [
          "remoteUrl",
          "name",
          "credentials",
          "cloneMode"
        ]
      },
      "Entry": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "folder",
              "file",
              "symlink",
              "submodule"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "nullable": true
          },
          "markdown": {
            "type": "boolean"
          },
          "ignored": {
            "type": "boolean"
          },
          "empty": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "kind",
          "size",
          "markdown",
          "ignored",
          "empty"
        ]
      },
      "FolderListing": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "ignored": {
            "type": "boolean"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Entry"
            }
          },
          "more": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "ignored",
          "entries",
          "more"
        ]
      },
      "CreateEntryRequest": {
        "type": "object",
        "properties": {
          "folder": {
            "type": "string",
            "maxLength": 4096
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "folder"
            ]
          }
        },
        "required": [
          "folder",
          "name",
          "kind"
        ]
      },
      "EntryPath": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "RenameEntryRequest": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "name"
        ]
      },
      "OnboardingStatus": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "required",
              "oidc-pending",
              "completed"
            ]
          },
          "oidcFromEnvironment": {
            "type": "boolean"
          },
          "setupTokenConfigured": {
            "type": "boolean"
          }
        },
        "required": [
          "state",
          "oidcFromEnvironment",
          "setupTokenConfigured"
        ]
      },
      "SetupTokenRequest": {
        "type": "object",
        "properties": {
          "setupToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "setupToken"
        ]
      },
      "PasswordSetupRequest": {
        "type": "object",
        "properties": {
          "setupToken": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "setupToken",
          "email",
          "displayName",
          "password"
        ]
      },
      "OidcSetupRequest": {
        "type": "object",
        "properties": {
          "setupToken": {
            "type": "string",
            "minLength": 1
          },
          "issuer": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "clientId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "clientSecret": {
            "type": "string",
            "maxLength": 1024
          },
          "scopes": {
            "default": "openid email profile",
            "type": "string",
            "maxLength": 512
          },
          "requireVerifiedEmail": {
            "default": true,
            "type": "boolean"
          },
          "adminEmail": {
            "type": "string"
          }
        },
        "required": [
          "setupToken",
          "issuer",
          "clientId",
          "adminEmail"
        ]
      },
      "OidcSetupView": {
        "type": "object",
        "properties": {
          "issuer": {
            "type": "string"
          },
          "clientId": {
            "type": "string"
          },
          "scopes": {
            "type": "string"
          },
          "requireVerifiedEmail": {
            "type": "boolean"
          },
          "adminEmail": {
            "type": "string"
          },
          "hasClientSecret": {
            "type": "boolean"
          }
        },
        "required": [
          "issuer",
          "clientId",
          "scopes",
          "requireVerifiedEmail",
          "adminEmail",
          "hasClientSecret"
        ]
      }
    }
  }
}
